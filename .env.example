# ==============================================================================
# DocuMind AI — Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
# DO NOT COMMIT SENSITIVE SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ----- General Environment -----
# Options: development, testing, staging, production
# Note: In production, default credentials (postgres:postgres) and default SECRET_KEY
# will fail startup validation for security.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ----- FastAPI Backend (services/api) -----
PROJECT_NAME="DocuMind API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
PORT=8000
SECRET_KEY="insecure-dev-secret-key-change-in-production"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ----- Database (PostgreSQL) -----
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documind
# Optional explicit full connection string (defaults to above credentials if unset):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/documind

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ----- Cache & Background Worker (Redis) -----
REDIS_URL=redis://localhost:6379/0

# ----- Next.js Frontend (apps/web) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
